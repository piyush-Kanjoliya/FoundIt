PORT=8080
APP_ORIGIN=http://localhost:5173
DATABASE_PATH=./data/reunite.sqlite
NODE_ENV=development
VITE_MAPBOX_ACCESS_TOKEN=pk.your_token_here
DEV_AUTO_VERIFY=true
TRUST_PROXY=false
ADMIN_EMAILS=
# development logs email-verification links in the backend terminal.
# production requires SMTP and HTTPS; links are never returned by the API.
# DEV_AUTO_VERIFY is rejected if NODE_ENV=production.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=VIT Reunite <no-reply@example.com>
