{
  "name": "vit-reunite",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "workspaces": [
    "client"
  ],
  "scripts": {
    "dev": "concurrently -k \"node --watch server/index.js\" \"npm run dev -w client\"",
    "dev:lan": "concurrently -k \"node --watch server/index.js\" \"npm run dev:lan -w client\"",
    "start": "node server/index.js",
    "build": "npm run build -w client",
    "doctor": "node scripts/doctor.js",
    "db:init": "node scripts/bootstrap.js",
    "db:seed": "node scripts/seed.js",
    "db:reset": "node scripts/reset.js",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "helmet": "^8.1.0",
    "multer": "^2.4.0",
    "nodemailer": "^7.0.6",
    "sharp": "^0.34.5",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@playwright/test": "1.55.0",
    "concurrently": "^9.2.1",
    "supertest": "^7.1.4"
  }
}
